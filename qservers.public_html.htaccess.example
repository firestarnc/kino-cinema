# QServers Apache template for Next.js app in public_html
# Copy this file to public_html/.htaccess and adjust as needed.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical trailing slash for key app routes to avoid route mismatches.
  RewriteRule ^book$ /book/ [R=301,L]
  RewriteRule ^now-showing$ /now-showing/ [R=301,L]
  RewriteRule ^experience$ /experience/ [R=301,L]
  RewriteRule ^membership$ /membership/ [R=301,L]
  RewriteRule ^screening/([^/]+)$ /screening/$1/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/_next/static/" IS_NEXT_STATIC

  # Next.js build assets are hashed and safe to cache aggressively.
  Header always set Cache-Control "public, max-age=31536000, immutable" env=IS_NEXT_STATIC

  # Public media cache.
  <FilesMatch "\.(jpg|jpeg|png|webp|avif|gif|svg|ico|woff|woff2|ttf|eot|css|js|mjs)$">
    Header always set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  BrotliCompressionQuality 5
  AddOutputFilterByType BROTLI_COMPRESS text/plain text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
